---
import { loadProducts } from '../data/products';

type Language = 'en' | 'ja';
interface Props { lang: Language }
const { lang } = Astro.props;
const ja = lang === 'ja';
const hardwareProducts = await loadProducts();

const copy = ja ? {
	title: 'CraftVia — オープンな組み込み開発基盤',
	description: 'CraftViaは、試作から製品までをつなぐオープンな組み込み開発基盤です。',
	nav: ['概要', 'ハードウェア', '開発状況', '設計原則', '運営者'],
	label: 'オープンハードウェア・プロジェクト',
	headline: '試作から製品までを、\nひとつの開発経路に。',
	lead: 'CraftViaは、製品指向のマイコンCoreと、開発・計測を担うStationを組み合わせた、オープンな組み込み開発基盤です。手軽に試し、実測し、同じCoreを実機へ移し、必要になればMCU直載せ設計へ移行できます。',
	docs: 'ドキュメントを見る', github: 'GitHubで見る',
	statusLabel: 'プロジェクト状況', status: '初期開発中', updated: '2026年10月更新',
	whyLabel: '概要', whyTitle: '開発ボードと専用PCBの\nあいだをつなぐ。',
	why: ['製品指向のMCU回路を案件ごとに一から設計する負担を減らします。', '書き込み、電源操作、ログ、電圧・電流測定を共通のStationへ集約します。', '試作で得た回路、ファームウェア、測定結果を次の設計へ持ち出せる形で残します。'],
	hardwareLabel: 'システム構成', hardwareTitle: '3つの役割を分離する',
	hardware: [
		['Core', '動くための共通部分', 'MCUと、その安定動作に必要な最小回路。Stationで開発した後、そのまま実機へ搭載します。'],
		['Station', '作り込む場所', '配線、書き込み、電源操作、ログ取得、電圧・電流測定を集約した開発・評価環境です。'],
		['Carrier', 'Coreを働かせる場所', 'センサー、通信、駆動回路など、装置ごとに異なる機能とCoreを接続する実装先です。'],
	],
	modelLabel: 'Coreという考え方', modelTitle: '開発機能を、\nマイコンボードから分離する。',
	modelIntro: '一般的なMCU開発ボードは、MCUに加えてデバッガ、USB、電源、スイッチ、LEDなどを一枚にまとめます。CraftViaは、繰り返し使用する開発機能をStationへ移し、CoreにはMCUを安定して動かすための必要十分な回路だけを残します。',
	compare: [
		['', '一般的なMCU開発ボード', 'CraftVia Core'],
		['ボード上の機能', 'MCUと開発機能を一枚に集約', 'MCUと必要十分な動作回路'],
		['書き込み・デバッグ', '各ボードに搭載、または外付け', '共通Stationへ集約'],
		['電源・計測', 'ボードごとに異なる', 'Stationで共通化し、測定可能'],
		['実機への移行', '開発機能ごと搭載、または再設計', '開発済みのCoreをそのまま移動'],
	],
	familyTitle: 'MCUが変わっても、開発環境は共通。',
	familyText: '異なるMCUにも同じ分離原則とCoreインターフェースを適用します。用途に合うCoreを選び、共通のStation上で同じ書き込み・電源・計測の流れを使えるプラットフォームを目指します。',
	familyCores: ['G031', 'ESP32-C3', 'RP2040'], familyStation: 'Common Station',
	pathLabel: '開発経路', pathTitle: 'Coreを使い続けることが目的ではありません。',
	pathIntro: '専用PCBが必要になる時点を後ろへ送り、必要になったときは公開された設計資産を使ってMCU直載せへ移行します。',
	path: ['Station + Core', '試作・ユニバーサル基板', 'Core + 専用Carrier', 'MCU直載せ設計'],
	statusSection: '開発状況', statusTitle: '現在取り組んでいるハードウェア',
	products: [
		['Core-S ESP32-C3', 'Core', '仕様検討中', '無線通信に対応する次期Core候補として、Core-Sへの適用仕様を検討しています。'],
		['Core-S RP2040', 'Core', '仕様検討中', 'RP2040を搭載する次期Core候補として、電源、書き込み、ピン構成を検討しています。'],
	],
	principlesLabel: '設計原則', principlesTitle: '公開し、測り、再現できること。',
	principles: [['01', 'Develop, measure, move, graduate', 'Stationで開発・計測し、実機へ移し、必要なら直載せ設計へ卒業する。'], ['02', 'Measure from the beginning', '書き込み、ログ、電圧、電流、テストポイントを後付けにしない。'], ['03', 'Document the reasoning', '設計データだけでなく、制約、失敗、測定条件、選定理由も公開する。'], ['04', 'Validate through real projects', '机上の汎用性ではなく、実際の試作と装置開発から得た知見を反映する。']],
	aboutLabel: 'プロジェクトについて', aboutTitle: 'CraftViaを、公開しながら育てていく。',
	aboutIntro: 'CraftViaは、仕様、設計データ、検証結果に加えて、設計上の判断や開発過程も公開し、再現可能な組み込み開発基盤として育てていくプロジェクトです。',
	founderName: '池田 航平', founderNameLatin: 'Kohei Ikeda', founderRole: 'プロジェクト発起人・開発者',
	founderBio: '回路設計、基板設計、ファームウェア、試作、計測を横断して組み込み機器の開発に取り組んでいます。試作から製品指向のハードウェアまでを、公開された再現可能な開発経路でつなぐことを目的にCraftViaを立ち上げました。',
	founderNotes: 'AKS Technical Notesで開発記事を読む', founderGithub: 'CraftViaをGitHubで見る',
	resourcesLabel: 'プロジェクト資料', resourcesTitle: '詳しく見る',
	resources: [['Documentation', '規格、互換性、設計指針、Getting Started。', 'GitHub', 'https://github.com/craftvia/craftvia-docs'], ['Hardware repositories', '編集可能な設計ソース、Gerber、BOM、CPL、回路図。', 'GitHub', 'https://github.com/craftvia'], ['Contributing', '課題報告、設計レビュー、開発への参加方法。', 'Issues', 'https://github.com/craftvia/craftvia-docs/issues']],
	canonicalNote: '英語版が内容管理上の正本です。日本語版は正式な翻訳として提供しています。',
	footerLine: 'Develop. Measure. Move. Graduate.',
} : {
	title: 'CraftVia — An open embedded development platform',
	description: 'CraftVia is an open embedded development platform connecting prototypes to products.',
	nav: ['Overview', 'Hardware', 'Status', 'Principles', 'About'],
	label: 'AN OPEN HARDWARE PROJECT',
	headline: 'One development path,\nfrom prototype to product.',
	lead: 'CraftVia is an open embedded development platform combining product-oriented MCU Cores with a Station for development and measurement. Build quickly, verify with real measurements, move the same Core into your device, and graduate to an integrated MCU design when the time is right.',
	docs: 'Read the documentation', github: 'View on GitHub',
	statusLabel: 'Project status', status: 'Early development', updated: 'Updated October 2026',
	whyLabel: 'Overview', whyTitle: 'Bridging development boards\nand custom PCBs.',
	why: ['Reduce the work of rebuilding a product-oriented MCU circuit for every project.', 'Bring programming, power control, logging, voltage, and current measurement into one reusable Station.', 'Carry circuits, firmware, and measured results from an early prototype into the next design.'],
	hardwareLabel: 'System', hardwareTitle: 'Three clearly separated roles',
	hardware: [
		['Core', 'The common part that runs', 'A compact MCU module with the minimum circuitry required for stable operation. Develop it on a Station, then install it in the device.'],
		['Station', 'The place where you develop', 'A reusable environment for wiring, programming, power control, logging, voltage measurement, and current measurement.'],
		['Carrier', 'The place where the Core works', 'The application-specific circuit connecting the Core to sensors, communications, drivers, power, and the outside world.'],
	],
	modelLabel: 'The Core model', modelTitle: 'Move development features\noff the MCU board.',
	modelIntro: 'A typical MCU development board combines the MCU with a debugger, USB interface, power supplies, switches, LEDs, and other development features. CraftVia moves reusable development functions to the Station and keeps only the circuitry necessary for reliable MCU operation on the Core.',
	compare: [
		['', 'Typical MCU development board', 'CraftVia Core'],
		['On-board functions', 'MCU and development features combined', 'MCU and sufficient operating circuitry'],
		['Programming and debug', 'On each board or externally attached', 'Centralized on a common Station'],
		['Power and measurement', 'Different for every board', 'Shared and measurable on the Station'],
		['Moving into a device', 'Carry development features or redesign', 'Move the developed Core directly'],
	],
	familyTitle: 'Different MCUs. One development environment.',
	familyText: 'The same separation principle and Core interface can be applied across multiple MCU families. Choose the Core that fits the application, then use a common Station and a consistent workflow for programming, power, and measurement.',
	familyCores: ['G031', 'ESP32-C3', 'RP2040'], familyStation: 'Common Station',
	pathLabel: 'Development path', pathTitle: 'The goal is not to use a Core forever.',
	pathIntro: 'Delay the need for a custom PCB, then use the published design assets to move to a directly integrated MCU when scale or requirements demand it.',
	path: ['Station + Core', 'Prototype / perfboard', 'Core + custom Carrier', 'Integrated MCU design'],
	statusSection: 'Development status', statusTitle: 'Hardware currently in development',
	products: [
		['Core-S ESP32-C3', 'Core', 'Specification in progress', 'A candidate next Core with wireless connectivity. Its application to the Core-S interface is under consideration.'],
		['Core-S RP2040', 'Core', 'Specification in progress', 'A candidate next Core based on RP2040. Power, programming, and pin allocation are under consideration.'],
	],
	principlesLabel: 'Design principles', principlesTitle: 'Open, measurable, reproducible.',
	principles: [['01', 'Develop, measure, move, graduate', 'Develop and measure on the Station, move into the device, and graduate to direct MCU integration.'], ['02', 'Measure from the beginning', 'Programming, logs, voltage, current, and test points are part of the design—not an afterthought.'], ['03', 'Document the reasoning', 'Publish constraints, failures, measurement conditions, and decisions alongside design files.'], ['04', 'Validate through real projects', 'Improve the platform using evidence from real prototypes, fixtures, and devices.']],
	aboutLabel: 'About the project', aboutTitle: 'Building CraftVia in the open.',
	aboutIntro: 'CraftVia publishes specifications, design files, verification results, and the reasoning behind the work. It is being developed as an open and reproducible path for embedded hardware.',
	founderName: 'Kohei Ikeda', founderNameLatin: '', founderRole: 'Founder & Developer',
	founderBio: 'An embedded systems and hardware developer working across circuit design, PCB development, firmware, prototyping, and measurement. He started CraftVia to connect early prototypes and product-oriented hardware through an open, reproducible development path.',
	founderNotes: 'Read development notes at AKS', founderGithub: 'View CraftVia on GitHub',
	resourcesLabel: 'Project resources', resourcesTitle: 'Explore the project',
	resources: [['Documentation', 'Standards, compatibility, design guidance, and Getting Started.', 'GitHub', 'https://github.com/craftvia/craftvia-docs'], ['Hardware repositories', 'Editable sources, Gerbers, BOMs, CPLs, and schematics.', 'GitHub', 'https://github.com/craftvia'], ['Contributing', 'Issue reporting, design review, and ways to participate.', 'Issues', 'https://github.com/craftvia/craftvia-docs/issues']],
	canonicalNote: 'This English version is the canonical source. The Japanese version is maintained as an official translation.',
	footerLine: 'Develop. Measure. Move. Graduate.',
};

const roleLabels = ja
	? { core: 'Core', station: 'Station', carrier: 'Carrier', makercard: 'MakerCard' }
	: { core: 'Core', station: 'Station', carrier: 'Carrier', makercard: 'MakerCard' };
const designStatusLabels = ja
	? { concept: '構想', draft: 'Draft', frozen: '設計凍結', superseded: '旧版' }
	: { concept: 'Concept', draft: 'Draft', frozen: 'Frozen design', superseded: 'Superseded' };
const verificationStatusLabels = ja
	? { unverified: '未検証', 'partially-verified': '一部検証済み', verified: '検証済み', rejected: '不合格' }
	: { unverified: 'Unverified', 'partially-verified': 'Partially verified', verified: 'Verified', rejected: 'Rejected' };
const hardwareStatusLabels = ja
	? { planned: '計画中', 'boards-ordered': '基板発注済み', assembled: '実装済み', testing: '検証中', released: '公開済み' }
	: { planned: 'Planned', 'boards-ordered': 'Boards ordered', assembled: 'Assembled', testing: 'Under test', released: 'Released' };

const productRows = [
	...hardwareProducts.map((product) => ({
		name: product.name,
		role: roleLabels[product.role],
		state: hardwareStatusLabels[product.hardwareStatus],
		meta: `${product.productVersion} ${product.pcbRevision} · ${designStatusLabels[product.designStatus]} · ${verificationStatusLabels[product.verificationStatus]}`,
		summary: product.summary[lang],
		href: product.repository,
		image: `/generated/products/${product.id}.webp`,
	})),
	...copy.products.map((product) => ({
		name: product[0],
		role: product[1],
		state: product[2],
		meta: '',
		summary: product[3],
		href: 'https://github.com/craftvia',
		image: null,
	})),
];

const anchorIds = ['overview', 'hardware', 'status', 'principles', 'about'];
const otherPath = ja ? '/' : '/ja/';
const canonicalUrl = ja ? 'https://craftvia.org/ja/' : 'https://craftvia.org/';
const ogImageUrl = 'https://craftvia.org/ogp.png';
const ogLocale = ja ? 'ja_JP' : 'en_US';
const ogAlternateLocale = ja ? 'en_US' : 'ja_JP';
const ogImageAlt = ja
	? 'CraftViaとCore-S、Station-S、MakerCard-Sの基板レンダリング'
	: 'CraftVia with Core-S, Station-S, and MakerCard-S board renderings';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={copy.description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CraftVia" />
		<meta property="og:title" content={copy.title} />
		<meta property="og:description" content={copy.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogAlternateLocale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1731" />
		<meta property="og:image:height" content="909" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={copy.title} />
		<meta name="twitter:description" content={copy.description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="icon" type="image/svg+xml" href="/craftvia-icon.svg" />
		<link rel="alternate" hreflang="en" href="/" /><link rel="alternate" hreflang="ja" href="/ja/" /><link rel="alternate" hreflang="x-default" href="/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{copy.title}</title>
	</head>
	<body>
		<header>
			<a class="brand" href={ja ? '/ja/' : '/'}><img src="/craftvia-wordmark.svg" alt="CraftVia" /></a>
			<nav aria-label="Main navigation">{copy.nav.map((item, i) => <a href={`#${anchorIds[i]}`}>{item}</a>)}</nav>
			<div class="tools"><a class="language" href={otherPath} lang={ja ? 'en' : 'ja'}>{ja ? 'EN' : '日本語'}</a><a class="github" href="https://github.com/craftvia" target="_blank" rel="noreferrer">GitHub ↗</a></div>
		</header>

		<main>
			<section class="hero" id="overview">
				<div class="hero-main"><p class="kicker">{copy.label}</p><h1>{copy.headline.split('\n').map((line) => <>{line}<br /></>)}</h1><p class="lead">{copy.lead}</p><div class="actions"><a class="primary" href="#resources">{copy.docs} →</a><a href="https://github.com/craftvia" target="_blank" rel="noreferrer">{copy.github} ↗</a></div></div>
				<aside><img src="/craftvia-icon.svg" alt="" /><dl><div><dt>{copy.statusLabel}</dt><dd><span></span>{copy.status}</dd></div><div><dt>Last updated</dt><dd>{copy.updated}</dd></div><div><dt>{ja ? 'ライセンス' : 'License'}</dt><dd>{ja ? '区分別オープンライセンス' : 'Open by category'}</dd></div></dl></aside>
			</section>

			<section class="overview section"><div class="section-head"><p>{copy.whyLabel}</p><h2>{copy.whyTitle.split('\n').map((line) => <>{line}<br /></>)}</h2></div><ol class="why-list">{copy.why.map((text, i) => <li><span>0{i + 1}</span><p>{text}</p></li>)}</ol></section>

			<section class="hardware section" id="hardware"><div class="section-head"><p>{copy.hardwareLabel}</p><h2>{copy.hardwareTitle}</h2></div><div class="hardware-grid">{copy.hardware.map((item, i) => <article><div class="card-number">0{i + 1}</div><h3>{item[0]}</h3><strong>{item[1]}</strong><p>{item[2]}</p></article>)}</div></section>

			<section class="core-model section">
				<div class="section-head"><p>{copy.modelLabel}</p><div><h2>{copy.modelTitle.split('\n').map((line) => <>{line}<br /></>)}</h2><p class="section-intro">{copy.modelIntro}</p></div></div>
				<div class="comparison" role="table" aria-label={copy.modelLabel}>{copy.compare.map((row, i) => <div class:list={['comparison-row', { heading: i === 0 }]} role="row">{row.map((cell) => <div role={i === 0 ? 'columnheader' : 'cell'}>{cell}</div>)}</div>)}</div>
				<div class="core-family"><div class="family-copy"><p class="label">MULTI-MCU PLATFORM</p><h3>{copy.familyTitle}</h3><p>{copy.familyText}</p></div><div class="family-diagram" aria-label={copy.familyTitle}><div class="cores">{copy.familyCores.map((core) => <div><span>CORE-S</span><strong>{core}</strong></div>)}</div><div class="connectors"><i></i><i></i><i></i></div><div class="station-box"><span>STATION-S</span><strong>{copy.familyStation}</strong><small>PROGRAM · POWER · MEASURE</small></div></div></div>
			</section>

			<section class="path section"><div class="path-copy"><p class="label">{copy.pathLabel}</p><h2>{copy.pathTitle}</h2><p>{copy.pathIntro}</p></div><div class="path-steps">{copy.path.map((step, i) => <div><span>{i + 1}</span><strong>{step}</strong>{i < copy.path.length - 1 && <b>↓</b>}</div>)}</div></section>

			<section class="status section" id="status"><div class="section-head"><p>{copy.statusSection}</p><h2>{copy.statusTitle}</h2></div><div class="product-table">{productRows.map((product) => <article class:list={{ 'with-image': product.image, 'without-image': !product.image }}>{product.image && <a class="product-image" href={product.href} target="_blank" rel="noreferrer" aria-label={`${product.name} on GitHub`}><img src={product.image} alt={ja ? `${product.name} 基板レンダリング` : `${product.name} board rendering`} loading="lazy" decoding="async" /></a>}<div class="product-identity"><span>{product.role}</span><h3>{product.name}</h3>{product.meta && <small class="product-meta">{product.meta}</small>}</div><div class="state">{product.state}</div><p>{product.summary}</p><a class="product-link" href={product.href} target="_blank" rel="noreferrer" aria-label={`${product.name} on GitHub`}>GitHub ↗</a></article>)}</div></section>

			<section class="principles section" id="principles"><div class="section-head"><p>{copy.principlesLabel}</p><h2>{copy.principlesTitle}</h2></div><div class="principle-grid">{copy.principles.map((item) => <article><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}</div></section>

			<section class="about section" id="about">
				<div class="section-head"><p>{copy.aboutLabel}</p><div><h2>{copy.aboutTitle}</h2><p class="section-intro">{copy.aboutIntro}</p></div></div>
				<div class="founder-card">
					<figure class="founder-photo"><img src="/images/kohei-ikeda.webp" alt={ja ? 'CraftVia発起人・開発者の池田航平' : 'Kohei Ikeda, Founder and Developer of CraftVia'} loading="lazy" decoding="async" /></figure>
					<div class="founder-profile">
						<p class="label">{copy.founderRole}</p>
						<h3>{copy.founderName}</h3>
						{copy.founderNameLatin && <p class="founder-name-latin">{copy.founderNameLatin}</p>}
						<p class="founder-bio">{copy.founderBio}</p>
						<div class="founder-links"><a href="https://aks-j.co.jp/technical-notes/" target="_blank" rel="noreferrer">{copy.founderNotes} ↗</a><a href="https://github.com/craftvia" target="_blank" rel="noreferrer">{copy.founderGithub} ↗</a></div>
					</div>
				</div>
			</section>

			<section class="resources section" id="resources"><div class="section-head"><p>{copy.resourcesLabel}</p><h2>{copy.resourcesTitle}</h2></div><div class="resource-list">{copy.resources.map((item) => <a href={item[3]} target="_blank" rel="noreferrer"><div><h3>{item[0]}</h3><p>{item[1]}</p></div><span>{item[2]} ↗</span></a>)}</div><p class="canonical">{copy.canonicalNote}</p></section>
		</main>

		<footer><div><img src="/craftvia-wordmark.svg" alt="CraftVia" /><p>{copy.footerLine}</p></div><div class="footer-links"><a href={otherPath}>{ja ? 'English' : '日本語'}</a><a href="https://github.com/craftvia">GitHub</a></div><small>© {new Date().getFullYear()} CraftVia</small></footer>
	</body>
</html>

<style>
	:root { --ink:#172019; --green:#0c6045; --line:#d8ddd8; --paper:#f7f8f5; --soft:#edf2ed; --accent:#c8ed45; --muted:#5f6962; --content-max:1440px; }
	* { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans','Noto Sans JP',sans-serif; } a { color:inherit; text-decoration:none; }
	header { position:sticky; top:0; z-index:20; height:72px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; padding:0 max(5vw,calc((100% - var(--content-max))/2)); background:rgba(247,248,245,.94); border-bottom:1px solid var(--line); backdrop-filter:blur(12px); }
	.brand img { display:block; width:136px; } nav { display:flex; gap:30px; color:var(--muted); font-size:12px; font-weight:600; } nav a:hover { color:var(--green); }
	.tools { justify-self:end; display:flex; align-items:center; gap:13px; font-size:12px; font-weight:600; } .language { padding:8px 10px; } .github { padding:9px 14px; border:1px solid var(--ink); border-radius:2px; }
	.hero { min-height:650px; display:grid; grid-template-columns:minmax(0,2fr) minmax(280px,.75fr); gap:8vw; align-items:center; padding:90px max(7vw,calc((100% - var(--content-max))/2)) 100px; border-bottom:1px solid var(--line); }
