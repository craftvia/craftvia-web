---
const destination = '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="refresh" content={`0; url=${destination}`} />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href="https://craftvia.org/" />
		<title>CraftVia</title>
		<script is:inline>window.location.replace('/');</script>
	</head>
	<body>
		<main>
			<p>Redirecting to <a href={destination}>CraftVia</a>…</p>
			<p lang="ja"><a href={destination}>CraftViaトップページ</a>へ移動します。</p>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
		background: #f7f8f5;
		color: #172019;
		font-family: system-ui, sans-serif;
	}
	main { text-align: center; }
	a { color: #0c6045; }
</style>
